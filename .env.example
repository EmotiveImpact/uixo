# Neon Postgres connection string. Use the pooled endpoint for serverless functions.
# Copy to .env.local and fill in — .env* is gitignored.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/uixo?sslmode=require

# Direct (unpooled) endpoint, for migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/uixo?sslmode=require

# Absolute origin used for canonical URLs, Open Graph tags and the sitemap at build time.
SITE_URL=https://uixo.dev

# Set to "true" only to preview a production build locally while auth is still mocked.
# Leaving this unset makes a production bundle refuse to start with the mock provider.
VITE_ALLOW_MOCK_AUTH=
