{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "cleanUrls": true,
  "functions": {
    "api/registry.ts": {
      "includeFiles": ["registry/**", "db/migrations/002-registry.sql", "data/registry/**"]
    },
    "api/mcp.ts": {
      "includeFiles": ["registry/**", "db/migrations/002-registry.sql", "data/registry/**"]
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
